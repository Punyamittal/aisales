# ============== REQUIRED (to run pipeline) ==============
# Ollama — no API key; run locally (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ============== OPTIONAL: Database ==============
# Supabase — https://app.supabase.com → Project → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ============== OPTIONAL: Send real emails ==============
# Resend — https://resend.com → API Keys (or use SMTP below)
RESEND_API_KEY=
EMAIL_FROM=outreach@yourdomain.com
EMAIL_FROM_NAME=AI Sales
# SMTP (e.g. Gmail) — used when RESEND_API_KEY is not set. For Gmail use app password (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
# Or use: MAIL=your@gmail.com and APP_PASSWORD=xxxx xxxx xxxx xxxx

# ============== App ==============
API_SECRET_KEY=change-me-in-production
ENVIRONMENT=development

# ============== Optional: contact enrichment ==============
# Hunter.io — https://hunter.io/api — fetch emails by company domain when suggesting companies
HUNTER_API_KEY=

# ============== FUTURE (not used yet) ==============
# OPENAI_API_KEY=       # If you add cloud LLM fallback

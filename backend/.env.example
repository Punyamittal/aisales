# Copy to .env and fill in. Run uvicorn from backend/ so this file is loaded.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Supabase (Project Settings → API: Project URL, anon key, service_role key)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
RESEND_API_KEY=
EMAIL_FROM=outreach@yourdomain.com
EMAIL_FROM_NAME=AI Sales
# SMTP (Gmail etc.) when Resend not set: SMTP_USER, SMTP_PASSWORD (or MAIL, APP_PASSWORD)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
API_SECRET_KEY=change-me-in-production
ENVIRONMENT=development

# GitHub (optional — for /api/github/repo: higher rate limits, private repos)
GITHUB_TOKEN=

# ============== REQUIRED: Lead Enrichment (Contact Emails) ==============
# No keys needed! System uses an automated web scraper (BeautifulSoup).

# ============== REQUIRED: Sending Outreach Emails ==============
# Setup Gmail App Password: https://myaccount.google.com/apppasswords
MAIL=your-email@gmail.com
APP_PASSWORD=abcd-efgh-ijkl-mnop
EMAIL_FROM_NAME=Your Name

# Hunter.io (optional — fetch contact names/emails when suggesting companies; add company_domain in suggester)
HUNTER_API_KEY=

# Apollo.io (optional — find people by company + job title/seniority, e.g. VP/CTO; returns names + titles + LinkedIn; emails come from Hunter/scraper)
APOLLO_API_KEY=
